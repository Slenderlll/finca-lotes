# Copia este archivo como .env y llena los valores. El archivo .env nunca se sube a Git.

# Entorno de ejecución: development | production
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Conexión a MongoDB (local o MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/finca_lotes

# Clave para firmar los JWT (mínimo 32 caracteres). Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Vigencia del token
JWT_EXPIRA=2h

# Otros orígenes permitidos por CORS, separados por coma. Déjalo vacío si el frontend
# lo sirve este mismo Express (el mismo origen siempre está permitido).
CORS_ORIGENES=

# Usuario administrador que crea "npm run seed"
ADMIN_CORREO=admin@montenublado.mx
ADMIN_PASSWORD=
