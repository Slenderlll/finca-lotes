{
  "info": {
    "name": "Finca Monte Nublado - Inventario de lotes",
    "description": "CRUD y autenticación. Cambia la variable baseUrl para probar el despliegue en la nube. Llena correoAdmin y passwordAdmin con los valores de tu .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "correoAdmin", "value": "admin@montenublado.mx" },
    { "key": "passwordAdmin", "value": "" },
    { "key": "token", "value": "" },
    { "key": "loteId", "value": "" },
    { "key": "codigoNuevo", "value": "MN-2026-900" }
  ],
  "item": [
    {
      "name": "Sistema",
      "item": [
        {
          "name": "Salud",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/salud" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login admin (guarda el token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correoAdmin}}\",\n  \"password\": \"{{passwordAdmin}}\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 con token', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().token).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ] }
          }]
        },
        {
          "name": "Login con contraseña incorrecta (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correoAdmin}}\",\n  \"password\": \"incorrecta\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Perfil",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/perfil" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Lotes",
      "item": [
        {
          "name": "Listar (público)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/lotes?estado=En bodega&limite=5" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Resumen (público)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/lotes/resumen" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Crear sin token (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/lotes",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"{{codigoNuevo}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Crear con datos inválidos (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/lotes",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"X\",\n  \"kilos\": -1\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Crear (guarda el id)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/lotes",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"{{codigoNuevo}}\",\n  \"parcela\": \"La Neblina\",\n  \"variedad\": \"Geisha\",\n  \"proceso\": \"Natural\",\n  \"estado\": \"En bodega\",\n  \"kilos\": 500,\n  \"precioKg\": 600,\n  \"puntaje\": 88.5,\n  \"fechaCosecha\": \"2026-03-20\",\n  \"notas\": \"Fresa y vino tinto.\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('loteId', pm.response.json().lote._id);"
            ] }
          }]
        },
        {
          "name": "Obtener uno",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/lotes/{{loteId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/lotes/{{loteId}}",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"{{codigoNuevo}}\",\n  \"parcela\": \"La Neblina\",\n  \"variedad\": \"Geisha\",\n  \"proceso\": \"Natural\",\n  \"estado\": \"Vendido\",\n  \"kilos\": 450,\n  \"precioKg\": 620,\n  \"puntaje\": 89,\n  \"fechaCosecha\": \"2026-03-20\",\n  \"notas\": \"Vendido a tostador local.\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 con los cambios', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().lote.estado).to.eql('Vendido');",
              "});"
            ] }
          }]
        },
        {
          "name": "Eliminar (solo admin)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/lotes/{{loteId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('204', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Obtener el eliminado (404)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/lotes/{{loteId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404', () => pm.response.to.have.status(404));"] } }]
        }
      ]
    }
  ]
}
